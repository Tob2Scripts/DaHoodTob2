		if state then
			local _,hum=targetParts(Users.Target)
			if not hum or not cam then Users.Spectating=false changedEvent:Fire()return end
			cam.CameraSubject=hum Users.Spectating=true
		else
			Users.Spectating=false
			local myHum=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if cam and myHum then cam.CameraSubject=myHum end
		end
		changedEvent:Fire()
	end
	function Users.SetTarget(obj)
		Users.Target=obj DaHood.Settings.Target=obj
		if Users.Spectating then
			local _,hum=targetParts(obj)local cam=Workspace.CurrentCamera
			if hum and cam then cam.CameraSubject=hum else Users.SetSpectating(false)return end
		end
		changedEvent:Fire()
	end
	function Users.SetFollowing(state)Users.Following=state and isValid(Users.Target)changedEvent:Fire()end
	function Users.Teleport()
		local _,_,tr=targetParts(Users.Target)local root=myRoot()
		if tr and root then root.CFrame=tr.CFrame*CFrame.new(0,0,4)end
	end
