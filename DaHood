			flyVel=flyVel:Lerp(tv,math.min(dt*10,1)) flyBody.Velocity=flyVel
			local cam2=Workspace.CurrentCamera
			if cam2 then local look=cam2.CFrame.LookVector local flat=Vector3.new(look.X,0,look.Z) if flat.Magnitude>0.01 then flyGyro.CFrame=CFrame.lookAt(root.Position,root.Position+flat) end end
		else stopFly(hum) end
		if S.GravityOn then
			if originalGravity==nil then originalGravity=Workspace.Gravity end Workspace.Gravity=S.Gravity
		elseif originalGravity~=nil then Workspace.Gravity=originalGravity originalGravity=nil end
	end)
	RunService.Stepped:Connect(function()
		local char=player.Character
		if S.Noclip and char then
			for _,part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") and part.CanCollide then part.CanCollide=false noclipParts[part]=true end end
		elseif next(noclipParts)~=nil then
			for part in pairs(noclipParts) do if part.Parent then part.CanCollide=true end noclipParts[part]=nil end
		end
	end)
	RunService:BindToRenderStep("MovFOV",Enum.RenderPriority.Camera.Value+3,function()
		local cam=Workspace.CurrentCamera if not cam then return end
		if S.FOVOn then if originalFOV==nil then originalFOV=cam.FieldOfView end cam.FieldOfView=S.FOV
		elseif originalFOV~=nil then cam.FieldOfView=originalFOV originalFOV=nil end
	end)
	UserInputService.JumpRequest:Connect(function()
		if not S.InfiniteJump then return end local _,hum=getChar() if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end)
	UserInputService.InputBegan:Connect(function(input,gp)
		if gp or Aim.IsCapturing() then return end
		if inputMatches(input,S.FlyBind) then S.Fly=not S.Fly changedEvent:Fire() end
		if inputMatches(input,S.WalkSpeedBind) then walkBound=true end
	end)
	UserInputService.InputEnded:Connect(function(input) if inputMatches(input,S.WalkSpeedBind) then walkBound=false end end)
	function Movement.Reset()
		S.WalkSpeedOn=false S.JumpPowerOn=false S.InfiniteJump=false S.Fly=false S.Noclip=false S.GravityOn=false S.FOVOn=false walkBound=false changedEvent:Fire()
	end
	return Movement
end)()
