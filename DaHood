	end)
end

local Aim=(function()
	local Aim={}
	Aim.Settings={
		CamLock={Enabled=false,Bind=Enum.KeyCode.Q,Mode="Toggle",TargetPart="Head",Smoothing=0,FOV=math.huge,TeamCheck=false,WallCheck=true,Sticky=true,Prediction=0.1,AutoRelock=true},
		SilentAim={Enabled=false,Bind=Enum.KeyCode.Z,TargetPart="Head",FOV=250,ShowFOV=true,TeamCheck=false,WallCheck=false,HitChance=100,Prediction=0.1,TestTracer=false},
	}
	local CL=Aim.Settings.CamLock
	local SA=Aim.Settings.SilentAim
	local changedEvent=Instance.new("BindableEvent")
	Aim.Changed=changedEvent.Event
	local function getPart(char,name)
		if name=="Head" then return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
		elseif name=="Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") end
		return char:FindFirstChild("HumanoidRootPart")
	end
	local function isEnemy(other,teamCheck)
		if not teamCheck then return true end
		local ok,same=pcall(function() return player.Team~=nil and other.Team==player.Team end)
		if ok and same then return false end return true
	end
	local rayParams=RaycastParams.new()
	rayParams.FilterType=Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater=true
	local function isVisible(part,char)
		local cam=Workspace.CurrentCamera if not cam then return false end
		local myChar=player.Character
		rayParams.FilterDescendantsInstances=myChar and{myChar}or{}
		local result=Workspace:Raycast(cam.CFrame.Position,part.Position-cam.CFrame.Position,rayParams)
		if not result then return true end
		return result.Instance:IsDescendantOf(char)
	end
	local function getMousePos()
		local cam=Workspace.CurrentCamera
		if cam and UserInputService.MouseBehavior==Enum.MouseBehavior.LockCenter then return cam.ViewportSize/2 end
		return UserInputService:GetMouseLocation()
	end
	local function findTarget(cfg,excludeChar)
		local cam=Workspace.CurrentCamera if not cam then return nil end
		local mousePos=getMousePos() local best,bestDist=nil,cfg.FOV
		local function consider(char)
			if char==excludeChar then return end
			local hum=char and char:FindFirstChildOfClass("Humanoid")
			local part=char and getPart(char,cfg.TargetPart)
			if not(hum and hum.Health>0 and part) then return end
			local screen,onScreen=cam:WorldToViewportPoint(part.Position)
			if not onScreen then return end
			local dist=(Vector2.new(screen.X,screen.Y)-mousePos).Magnitude
			if dist<bestDist and(not cfg.WallCheck or isVisible(part,char)) then best,bestDist=part,dist end
		end
		for _,other in ipairs(Players:GetPlayers()) do if other~=player and isEnemy(other,cfg.TeamCheck) then consider(other.Character) end end
		return best
	end
	local function isAlive(part)
		if not part or not part.Parent then return false end
		local hum=part.Parent:FindFirstChildOfClass("Humanoid")
		return hum~=nil and hum.Health>0
	end
	local function aimPos(part,cfg)
		local vel=Vector3.zero pcall(function() vel=part.AssemblyLinearVelocity end)
		return part.Position+vel*cfg.Prediction
	end
	function Aim.GetSilentTarget()
		if not SA.Enabled then return nil end if math.random(1,100)>SA.HitChance then return nil end return findTarget(SA)
	end
	function Aim.GetAimPoint(def) local p=Aim.GetSilentTarget() return p and aimPos(p,SA) or def end
	function Aim.RedirectShot(origin,dir)
		local p=Aim.GetSilentTarget() if not p then return dir end
		local to=aimPos(p,SA)-origin if to.Magnitude<1e-3 then return dir end return to.Unit*dir.Magnitude
	end
	local function isDir(v) if typeof(v)~="Vector3" then return false end local m=v.Magnitude return m>0.01 and m<5 end
	local function isPos(v) if typeof(v)~="Vector3" then return false end return v.Magnitude>=5 end
	local rfShots={} local rfEnabled=false local rfRate=0.05
	pcall(function()
		local mt=getrawmetatable(game)
		local old=mt.__namecall
		setreadonly(mt,false)
		mt.__namecall=newcclosure(function(self,...)
			local method=getnamecallmethod()
			if method=="FireServer" and self:IsA("RemoteEvent") then
				local args={...}
				if SA.Enabled and math.random(1,100)<=SA.HitChance then
					local target=findTarget(SA)
					if target then
						local tp=aimPos(target,SA)
						local hasDir=false
						for _,a in ipairs(args) do if isDir(a) then hasDir=true break end end
						for i,arg in ipairs(args) do
							if isDir(arg) then
								local origin=Vector3.zero
								for j=1,i-1 do if isPos(args[j]) then origin=args[j] break end end
								local to=tp-origin if to.Magnitude>0.01 then args[i]=to.Unit*arg.Magnitude end
							elseif not hasDir and typeof(arg)=="Vector3" and isPos(arg) then args[i]=tp end
						end
					end
				end
				if rfEnabled then rfShots[tostring(self)]={remote=self,args={table.unpack(args)},last=tick()} end
				return old(self,table.unpack(args))
			end
			return old(self,...)
		end)
		setreadonly(mt,true)
	end)
	RunService.Heartbeat:Connect(function()
		if not rfEnabled then if next(rfShots) then table.clear(rfShots) end return end
		local now=tick()
		for _,data in pairs(rfShots) do
			if now-data.last>=rfRate then
				data.last=now
				pcall(function()
					local args={table.unpack(data.args)}
					if SA.Enabled then
						local t=findTarget(SA)
						if t then
							local tp=aimPos(t,SA)
							for i,arg in ipairs(args) do
								if isDir(arg) then
									local origin=Vector3.zero
									for j=1,i-1 do if isPos(args[j]) then origin=args[j] break end end
									local to=tp-origin if to.Magnitude>0.01 then args[i]=to.Unit*arg.Magnitude end
								end
							end
						end
					end
					data.remote:FireServer(table.unpack(args))
				end)
			end
		end
	end)
	function Aim.SetRapidFireHook(en,rate) rfEnabled=en if rate then rfRate=rate end end
	local captureCallback=nil local capturedThisFrame=false local holding=false
	local lockedTarget=nil local lockedDiedConn=nil
	local function clearLock()
		if lockedDiedConn then lockedDiedConn:Disconnect() lockedDiedConn=nil end lockedTarget=nil
	end
	local function onTargetDied()
		clearLock()
		if not CL.AutoRelock then CL.Enabled=false changedEvent:Fire("CamLock","Enabled",false) end
	end
	local function lockOnto(part)
		clearLock() lockedTarget=part
		local hum=part and part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
		if hum then lockedDiedConn=hum.Died:Connect(onTargetDied) end
	end
	function Aim.CaptureBind(cb) captureCallback=cb end
	function Aim.IsCapturing() return captureCallback~=nil or capturedThisFrame end
	local function matches(input,bind)
		if not bind then return false end
		if bind.EnumType==Enum.KeyCode then return input.KeyCode==bind end
		return input.UserInputType==bind
	end
	UserInputService.InputBegan:Connect(function(input,gp)
		if captureCallback then
			local cb=captureCallback local result,done=nil,false
			if input.UserInputType==Enum.UserInputType.Keyboard then
				done=true
				if input.KeyCode==Enum.KeyCode.Backspace or input.KeyCode==Enum.KeyCode.Delete then result=false
				elseif input.KeyCode~=Enum.KeyCode.Escape then result=input.KeyCode end
			elseif input.UserInputType==Enum.UserInputType.MouseButton2 or input.UserInputType==Enum.UserInputType.MouseButton3 then
				done=true result=input.UserInputType
			end
			if done then captureCallback=nil capturedThisFrame=true task.defer(function() capturedThisFrame=false end) cb(result) end
			return
		end
		if gp then return end
		if matches(input,CL.Bind) then
			if CL.Mode=="Toggle" then CL.Enabled=not CL.Enabled if not CL.Enabled then clearLock() end changedEvent:Fire("CamLock","Enabled",CL.Enabled)
			else holding=true end
		end
		if matches(input,SA.Bind) then SA.Enabled=not SA.Enabled changedEvent:Fire("SilentAim","Enabled",SA.Enabled) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if matches(input,CL.Bind) then holding=false if CL.Mode~="Toggle" then clearLock() end end
	end)
	local fovGui=playerGui:FindFirstChild("AimFOV") if fovGui then fovGui:Destroy() end
	fovGui=Instance.new("ScreenGui") fovGui.Name="AimFOV" fovGui.ResetOnSpawn=false fovGui.IgnoreGuiInset=true fovGui.DisplayOrder=50 fovGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling fovGui.Parent=playerGui
	local silentCircle=Instance.new("Frame")
	silentCircle.AnchorPoint=Vector2.new(0.5,0.5) silentCircle.BackgroundTransparency=1 silentCircle.BorderSizePixel=0 silentCircle.Visible=false silentCircle.Parent=fovGui
	do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0.5,0) c.Parent=silentCircle end
	do local s=Instance.new("UIStroke") s.Color=Color3.fromRGB(70,190,255) s.Thickness=1.5 s.Transparency=0.25 s.Parent=silentCircle end
	local lockDot=Instance.new("Frame")
	lockDot.AnchorPoint=Vector2.new(0.5,0.5) lockDot.Size=UDim2.fromOffset(10,10) lockDot.BackgroundColor3=Color3.fromRGB(124,92,255) lockDot.BorderSizePixel=0 lockDot.Visible=false lockDot.ZIndex=10 lockDot.Parent=fovGui
	do local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0.5,0) c.Parent=lockDot end
	do local s=Instance.new("UIStroke") s.Color=Color3.fromRGB(255,255,255) s.Thickness=1 s.Transparency=0.5 s.Parent=lockDot end
	RunService:BindToRenderStep("AimAssist",Enum.RenderPriority.Camera.Value+1,function(dt)
		silentCircle.Visible=SA.Enabled and SA.ShowFOV
		if silentCircle.Visible then local m=getMousePos() silentCircle.Position=UDim2.fromOffset(m.X,m.Y) silentCircle.Size=UDim2.fromOffset(SA.FOV*2,SA.FOV*2) end
		local cam=Workspace.CurrentCamera
		local active=CL.Enabled and(CL.Mode=="Toggle" or holding)
		if not active or not cam then lockDot.Visible=false return end
		if lockedTarget and not isAlive(lockedTarget) then clearLock() end
		if not lockedTarget then local f=findTarget(CL) if f then lockOnto(f) end end
		if not lockedTarget then lockDot.Visible=false return end
		local sp,on=cam:WorldToViewportPoint(lockedTarget.Position)
		lockDot.Visible=on if on then lockDot.Position=UDim2.fromOffset(sp.X,sp.Y) end
		local goal=CFrame.lookAt(cam.CFrame.Position,aimPos(lockedTarget,CL))
		local alpha=CL.Smoothing>0 and(1-CL.Smoothing^(dt*60))or 1
		cam.CFrame=cam.CFrame:Lerp(goal,alpha)
	end)
	return Aim
end)()
