local DaHood=(function()
	local DH={}
	DH.Settings={
		KillAuraEnabled=false,KillAuraBind=Enum.KeyCode.K,KillAuraRadius=3,KillAuraSpeed=4,KillAuraHeight=0.5,StompRate=0.08,
		OrbitEnabled=false,OrbitBind=Enum.KeyCode.O,OrbitRadius=5,OrbitSpeed=3,OrbitHeight=0,
		ArrestDodgeEnabled=false,ArrestDodgeBind=Enum.KeyCode.J,ArrestDodgeDist=30,
		NoRagdollEnabled=false,NoRagdollBind=Enum.KeyCode.N,
		AutoReviveEnabled=false,AutoReviveBind=Enum.KeyCode.V,AutoReviveDist=6,
		AutoBagEnabled=false,AutoBagBind=Enum.KeyCode.B,
		JailEscapeBind=Enum.KeyCode.P,
		Target=nil,
	}
	local DS=DH.Settings
	local changedEvent=Instance.new("BindableEvent") DH.Changed=changedEvent.Event
	local orbitAngle=0 local lastStomp=0
	local function findNearest()
		local _,_,myRoot=getChar() if not myRoot then return nil end
		local best,bestDist=nil,math.huge
		for _,other in ipairs(Players:GetPlayers()) do
			if other~=player then
				local char=other.Character local root=char and char:FindFirstChild("HumanoidRootPart")
				local hum=char and char:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health>0 then
					local dist=(root.Position-myRoot.Position).Magnitude
					if dist<bestDist then best=other bestDist=dist end
				end
			end
		end
		return best
	end
	local BAG_NAMES={"MoneyBag","Money Bag","moneybag","CashBag","Cash Bag","Bag","bag"}
	local function findBags()
		local bags={}
		for _,obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") or obj:IsA("Model") then
				for _,name in ipairs(BAG_NAMES) do
					if obj.Name:lower():find(name:lower(),1,true) then table.insert(bags,obj) break end
				end
			end
		end
		return bags
	end
	RunService.Heartbeat:Connect(function(dt)
		local char,hum,myRoot=getChar()
		if not myRoot or not hum or hum.Health<=0 then return end
		if DS.NoRagdollEnabled then
			pcall(function()
				if hum:GetState()==Enum.HumanoidStateType.Ragdoll or hum:GetState()==Enum.HumanoidStateType.FallingDown then
					hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end)
		end
		if DS.ArrestDodgeEnabled then
			for _,other in ipairs(Players:GetPlayers()) do
				if other~=player then
					local oChar=other.Character local oRoot=oChar and oChar:FindFirstChild("HumanoidRootPart")
					if oRoot and(oRoot.Position-myRoot.Position).Magnitude<5.5 then
						myRoot.CFrame=myRoot.CFrame*CFrame.new(0,0,DS.ArrestDodgeDist)
					end
				end
			end
		end
		if DS.KillAuraEnabled then
			local target=findNearest()
			if target then
				local tChar=target.Character local tRoot=tChar and tChar:FindFirstChild("HumanoidRootPart")
				local tHum=tChar and tChar:FindFirstChildOfClass("Humanoid")
				if tRoot and tHum and tHum.Health>0 then
					orbitAngle=orbitAngle+DS.KillAuraSpeed*dt
					local r=DS.KillAuraRadius
					myRoot.CFrame=CFrame.new(tRoot.Position.X+math.cos(orbitAngle)*r,tRoot.Position.Y+DS.KillAuraHeight,tRoot.Position.Z+math.sin(orbitAngle)*r)*CFrame.Angles(0,-orbitAngle-math.pi/2,0)
					local now=tick()
					if now-lastStomp>=DS.StompRate then
						lastStomp=now
						myRoot.CFrame=CFrame.new(tRoot.Position+Vector3.new(0,2,0))
						clickMouse()
					end
				end
			end
		elseif DS.OrbitEnabled and DS.Target then
			local obj=DS.Target if not obj or not obj.Parent then DS.Target=nil return end
			local tChar=obj:IsA("Player") and obj.Character or obj
			local tRoot=tChar and tChar:FindFirstChild("HumanoidRootPart")
			if tRoot then
				orbitAngle=orbitAngle+DS.OrbitSpeed*dt
				local r=DS.OrbitRadius
				myRoot.CFrame=CFrame.new(tRoot.Position.X+math.cos(orbitAngle)*r,tRoot.Position.Y+DS.OrbitHeight,tRoot.Position.Z+math.sin(orbitAngle)*r)*CFrame.Angles(0,-orbitAngle-math.pi/2,0)
			end
		end
		if DS.AutoReviveEnabled then
			for _,other in ipairs(Players:GetPlayers()) do
				if other~=player then
					local oChar=other.Character local oHum=oChar and oChar:FindFirstChildOfClass("Humanoid")
					local oRoot=oChar and oChar:FindFirstChild("HumanoidRootPart")
					if oHum and oHum.Health<=0 and oRoot and(oRoot.Position-myRoot.Position).Magnitude<=DS.AutoReviveDist then
						myRoot.CFrame=CFrame.new(oRoot.Position+Vector3.new(0,2,0))
						if VU then pcall(function() VU:KeyDown(string.byte("e")) task.delay(0.1,function() pcall(function() VU:KeyUp(string.byte("e")) end) end) end) end
					end
				end
			end
		end
		if DS.AutoBagEnabled then
			local bags=findBags()
			if #bags>0 then
				local closest,closestDist=nil,math.huge
				for _,bag in ipairs(bags) do
					local pos=bag:IsA("BasePart") and bag.Position or(bag.PrimaryPart and bag.PrimaryPart.Position)
					if pos then local d=(pos-myRoot.Position).Magnitude if d<closestDist then closest=bag closestDist=d end end
				end
				if closest then
					local pos=closest:IsA("BasePart") and closest.Position or(closest.PrimaryPart and closest.PrimaryPart.Position)
					if pos then myRoot.CFrame=CFrame.new(pos+Vector3.new(0,2,0)) end
				end
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input,gp)
		if gp or Aim.IsCapturing() then return end
		if inputMatches(input,DS.KillAuraBind) then DS.KillAuraEnabled=not DS.KillAuraEnabled changedEvent:Fire() end
		if inputMatches(input,DS.OrbitBind) then DS.OrbitEnabled=not DS.OrbitEnabled changedEvent:Fire() end
		if inputMatches(input,DS.ArrestDodgeBind) then DS.ArrestDodgeEnabled=not DS.ArrestDodgeEnabled changedEvent:Fire() end
		if inputMatches(input,DS.NoRagdollBind) then DS.NoRagdollEnabled=not DS.NoRagdollEnabled changedEvent:Fire() end
		if inputMatches(input,DS.AutoReviveBind) then DS.AutoReviveEnabled=not DS.AutoReviveEnabled changedEvent:Fire() end
		if inputMatches(input,DS.AutoBagBind) then DS.AutoBagEnabled=not DS.AutoBagEnabled changedEvent:Fire() end
		if inputMatches(input,DS.JailEscapeBind) then
			local _,_,root=getChar()
			if root then
				local sp=Workspace:FindFirstChild("Spawn") or Workspace:FindFirstChild("SpawnLocation")
				if sp and sp:IsA("BasePart") then root.CFrame=sp.CFrame+Vector3.new(0,5,0)
				else root.CFrame=CFrame.new(root.Position+Vector3.new(0,60,0)) end
			end
		end
	end)
	return DH
end)()
_G.Tob2DaHood=DaHood

