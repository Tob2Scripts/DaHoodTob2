local ESP=(function()
	local ESP={}
	ESP.Settings={Enabled=false,Bind=Enum.KeyCode.X,Box=true,Name=true,Distance=true,Health=true,Outline=true,Fill=false,Tracers=false,TracerOrigin="Bottom",TeamCheck=false,TeamColors=false,MaxDistance=1000,Color="Purple"}
	local S=ESP.Settings
	ESP.ColorNames={"Purple","Red","Green","Blue","White","Yellow","Orange"}
	local COLORS={Purple=Color3.fromRGB(124,92,255),Red=Color3.fromRGB(235,64,72),Green=Color3.fromRGB(80,220,140),Blue=Color3.fromRGB(70,150,255),White=Color3.fromRGB(240,240,245),Yellow=Color3.fromRGB(250,215,70),Orange=Color3.fromRGB(255,150,60)}
	local changedEvent=Instance.new("BindableEvent") ESP.Changed=changedEvent.Event
	local espGui=playerGui:FindFirstChild("Tob2ESP") if espGui then espGui:Destroy() end
	espGui=Instance.new("ScreenGui") espGui.Name="Tob2ESP" espGui.ResetOnSpawn=false espGui.IgnoreGuiInset=true espGui.DisplayOrder=40 espGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling espGui.Parent=playerGui
	local hlFolder=Workspace:FindFirstChild("Tob2Highlights") if hlFolder then hlFolder:Destroy() end
	hlFolder=Instance.new("Folder") hlFolder.Name="Tob2Highlights" hlFolder.Parent=Workspace
	local objects={}
	local function makeLabel()
		local l=Instance.new("TextLabel") l.BackgroundTransparency=1 l.Font=Enum.Font.GothamBold l.TextSize=13 l.TextStrokeTransparency=0.4 l.Size=UDim2.fromOffset(200,14) l.AnchorPoint=Vector2.new(0.5,0) l.Visible=false l.Parent=espGui return l
	end
	local function createObjects(plr)
		if objects[plr] then return end local o={}
		o.Box=Instance.new("Frame") o.Box.BackgroundTransparency=1 o.Box.BorderSizePixel=0 o.Box.Visible=false o.Box.Parent=espGui
		o.BoxStroke=Instance.new("UIStroke") o.BoxStroke.Thickness=1.5 o.BoxStroke.Parent=o.Box
		o.NameLabel=makeLabel() o.DistanceLabel=makeLabel()
		o.HealthBack=Instance.new("Frame") o.HealthBack.BackgroundColor3=Color3.fromRGB(0,0,0) o.HealthBack.BackgroundTransparency=0.35 o.HealthBack.BorderSizePixel=0 o.HealthBack.Visible=false o.HealthBack.Parent=espGui
		o.HealthFill=Instance.new("Frame") o.HealthFill.AnchorPoint=Vector2.new(0,1) o.HealthFill.Position=UDim2.fromScale(0,1) o.HealthFill.Size=UDim2.fromScale(1,1) o.HealthFill.BorderSizePixel=0 o.HealthFill.Parent=o.HealthBack
		o.Tracer=Instance.new("Frame") o.Tracer.AnchorPoint=Vector2.new(0.5,0.5) o.Tracer.BorderSizePixel=0 o.Tracer.Visible=false o.Tracer.Parent=espGui
		o.Highlight=Instance.new("Highlight") o.Highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop o.Highlight.Enabled=false o.Highlight.Parent=hlFolder
		objects[plr]=o
	end
	local function removeObjects(plr)
		local o=objects[plr] if not o then return end
		o.Box:Destroy() o.NameLabel:Destroy() o.DistanceLabel:Destroy() o.HealthBack:Destroy() o.Tracer:Destroy() o.Highlight:Destroy() objects[plr]=nil
	end
	local function hideDrawings(o) o.Box.Visible=false o.NameLabel.Visible=false o.DistanceLabel.Visible=false o.HealthBack.Visible=false o.Tracer.Visible=false end
	local function hideAll(o) hideDrawings(o) o.Highlight.Enabled=false end
	RunService:BindToRenderStep("ESPUpdate",Enum.RenderPriority.Camera.Value+2,function()
		local cam=Workspace.CurrentCamera if not cam then return end
		local vp=cam.ViewportSize local cp=cam.CFrame.Position
		for plr,o in pairs(objects) do
			local char=plr.Character local hum=char and char:FindFirstChildOfClass("Humanoid")
			local root=char and char:FindFirstChild("HumanoidRootPart")
			local show=S.Enabled and hum~=nil and root~=nil and hum.Health>0
			if show and S.TeamCheck and player.Team~=nil and plr.Team==player.Team then show=false end
			local dist=0
			if show then dist=(cp-root.Position).Magnitude if dist>S.MaxDistance then show=false end end
			if not show then hideAll(o) continue end
			local color=S.TeamColors and plr.TeamColor.Color or COLORS[S.Color]
			local hl=o.Highlight if hl.Adornee~=char then hl.Adornee=char end
			hl.Enabled=S.Outline or S.Fill hl.FillColor=color hl.OutlineColor=color
			hl.FillTransparency=S.Fill and 0.6 or 1 hl.OutlineTransparency=S.Outline and 0 or 1
			local cf,size=char:GetBoundingBox()
			local half=Vector3.new(0,size.Y/2,0)
			local top=cam:WorldToViewportPoint(cf.Position+half)
			local bot=cam:WorldToViewportPoint(cf.Position-half)
			if top.Z<=0 or bot.Z<=0 then hideDrawings(o) continue end
			local height=math.abs(bot.Y-top.Y) local width=height*0.55
			local cx=(top.X+bot.X)/2 local x=cx-width/2 local y=math.min(top.Y,bot.Y)
			o.Box.Visible=S.Box if S.Box then o.Box.Position=UDim2.fromOffset(x,y) o.Box.Size=UDim2.fromOffset(width,height) o.BoxStroke.Color=color end
			o.NameLabel.Visible=S.Name if S.Name then o.NameLabel.Text=plr.DisplayName o.NameLabel.TextColor3=color o.NameLabel.Position=UDim2.fromOffset(cx,y-16) end
			o.DistanceLabel.Visible=S.Distance if S.Distance then o.DistanceLabel.Text=math.floor(dist+0.5).." studs" o.DistanceLabel.TextColor3=color o.DistanceLabel.Position=UDim2.fromOffset(cx,y+height+2) end
			o.HealthBack.Visible=S.Health
			if S.Health then
				local ratio=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
				o.HealthBack.Position=UDim2.fromOffset(x-6,y) o.HealthBack.Size=UDim2.fromOffset(3,height)
				o.HealthFill.Size=UDim2.fromScale(1,ratio) o.HealthFill.BackgroundColor3=Color3.fromHSV(ratio*0.33,1,1)
			end
			o.Tracer.Visible=S.Tracers
			if S.Tracers then
				local from=Vector2.new(vp.X/2,S.TracerOrigin=="Center" and vp.Y/2 or vp.Y)
				local to=Vector2.new(cx,y+height) local delta=to-from local mid=(from+to)/2
				o.Tracer.Size=UDim2.fromOffset(delta.Magnitude,1.5) o.Tracer.Position=UDim2.fromOffset(mid.X,mid.Y)
				o.Tracer.Rotation=math.deg(math.atan2(delta.Y,delta.X)) o.Tracer.BackgroundColor3=color
			end
		end
	end)
	for _,plr in ipairs(Players:GetPlayers()) do if plr~=player then createObjects(plr) end end
	Players.PlayerAdded:Connect(function(plr) if plr~=player then createObjects(plr) end end)
	Players.PlayerRemoving:Connect(removeObjects)
	UserInputService.InputBegan:Connect(function(input,gp)
		if gp or Aim.IsCapturing() then return end
		local bind=S.Bind if not bind then return end
		local hit=bind.EnumType==Enum.KeyCode and input.KeyCode==bind or input.UserInputType==bind
		if hit then S.Enabled=not S.Enabled changedEvent:Fire() end
	end)
	return ESP
end)()
_G.Tob2ESP=ESP

local Users=(function()
	local Users={} Users.Target=nil Users.Spectating=false Users.Following=false
	local changedEvent=Instance.new("BindableEvent") Users.Changed=changedEvent.Event
	local function displayName(obj) if obj:IsA("Player") then return obj.DisplayName end return obj.Name end
	local function targetParts(obj)
		if not obj then return nil,nil,nil end
		local char=obj:IsA("Player") and obj.Character or obj
		return char,char and char:FindFirstChildOfClass("Humanoid"),char and char:FindFirstChild("HumanoidRootPart")
	end
	local function isValid(obj) return obj~=nil and obj.Parent~=nil end
	local function myRoot() local char=player.Character return char and char:FindFirstChild("HumanoidRootPart") end
	function Users.List()
		local list={}
		for _,plr in ipairs(Players:GetPlayers()) do if plr~=player then table.insert(list,plr) end end
		table.sort(list,function(a,b) return a.Name:lower()<b.Name:lower() end) return list
	end
	function Users.Search(query)
		query=string.lower(query) local matches,loose={},{}
		for _,obj in ipairs(Users.List()) do
			local name=obj.Name:lower() local disp=displayName(obj):lower()
			if query=="" or name:sub(1,#query)==query or disp:sub(1,#query)==query then table.insert(matches,obj)
			elseif name:find(query,1,true) or disp:find(query,1,true) then table.insert(loose,obj) end
		end
		for _,o in ipairs(loose) do table.insert(matches,o) end return matches
	end
	function Users.SetSpectating(state)
		local cam=Workspace.CurrentCamera
		if state then
			local _,hum=targetParts(Users.Target)
			if not hum or not cam then Users.Spectating=false changedEvent:Fire() return end
			cam.CameraSubject=hum Users.Spectating=true
		else
			Users.Spectating=false
			local myHum=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if cam and myHum then cam.CameraSubject=myHum end
		end
		changedEvent:Fire()
	end
	function Users.SetTarget(obj)
		Users.Target=obj DaHood.Settings.Target=obj
		if Users.Spectating then
			local _,hum=targetParts(obj) local cam=Workspace.CurrentCamera
			if hum and cam then cam.CameraSubject=hum else Users.SetSpectating(false) return end
		end
		changedEvent:Fire()
	end
	function Users.SetFollowing(state) Users.Following=state and isValid(Users.Target) changedEvent:Fire() end
	function Users.Teleport()
		local _,_,tr=targetParts(Users.Target) local root=myRoot()
		if tr and root then root.CFrame=tr.CFrame*CFrame.new(0,0,4) end
	end
	function Users.Cycle(step)
		local list=Users.List() if #list==0 then return end
		local index=table.find(list,Users.Target) or(step>0 and 0 or 1)
		index=(index-1+step)%#list+1 Users.SetTarget(list[index])
	end
	function Users.Info()
		local obj=Users.Target if not isValid(obj) then return "No target selected" end
		local _,hum,root=targetParts(obj) local mine=myRoot()
		if hum and root and mine then
			return string.format("%s  |  %d HP  |  %d studs",displayName(obj),math.floor(hum.Health+0.5),math.floor((root.Position-mine.Position).Magnitude+0.5))
		end
		return displayName(obj).."  |  no character"
	end
	RunService.Heartbeat:Connect(function()
		local obj=Users.Target
		if Users.Spectating then
			local cam=Workspace.CurrentCamera local _,hum=targetParts(obj)
			if not isValid(obj) or not hum then Users.SetSpectating(false)
			elseif cam and cam.CameraSubject~=hum then cam.CameraSubject=hum end
		end
		if Users.Following then
			if not isValid(obj) then Users.Following=false changedEvent:Fire()
			else local _,_,tr=targetParts(obj) local root=myRoot() if tr and root then root.CFrame=tr.CFrame*CFrame.new(0,0,4) end end
		end
	end)
	return Users
end)()
_G.Tob2Users=Users

local Config=(function()
	local Config={} Config.Slots={}
	Config.Sections={CamLock=Aim.Settings.CamLock,SilentAim=Aim.Settings.SilentAim,ESP=ESP.Settings,Movement=Movement.Settings,RapidFire=RapidFire.Settings,DaHood=DaHood.Settings,Menu=MenuSettings}
	local function encode(v)
		local k=typeof(v)
		if k=="boolean" or k=="string" then return v end
		if k=="number" then if v==v and v~=math.huge and v~=-math.huge then return v end return nil end
		if k=="EnumItem" then return{Enum=tostring(v.EnumType),Name=v.Name} end return nil
	end
	local function decode(saved,current,key)
		if type(saved)=="table" then
			if saved.Enum and saved.Name then
				local ok,et=pcall(function() return Enum[saved.Enum] end)
				if ok and et then local ok2,item=pcall(function() return et[saved.Name] end) if ok2 and item then return item end end
			end return nil
		end
		if key:sub(-4)=="Bind" and saved==false then return false end
		if type(saved)==type(current) then return saved end return nil
	end
	local function capture()
		local data={}
		for sn,section in pairs(Config.Sections) do
			local out={}
			for key,value in pairs(section) do local e=encode(value) if e~=nil then out[key]=e end end
			data[sn]=out
		end
		return data
	end
	local function apply(data)
		for sn,saved in pairs(data) do
			local section=Config.Sections[sn]
			if section and type(saved)=="table" then
				for key,sv in pairs(saved) do
					local current=section[key]
					if current~=nil and type(current)~="function" and type(current)~="table" then
						local v=decode(sv,current,key)
						if section==MenuSettings and(not v or v.EnumType~=Enum.KeyCode) then v=nil end
						if v~=nil then section[key]=v end
					end
				end
			end
		end
	end
	Config.Defaults=capture()
	function Config.Export() local ok,r=pcall(function() return HttpService:JSONEncode({v=1,d=capture()}) end) return ok and r or "" end
	function Config.Import(text)
		if type(text)~="string" or text:match("^%s*$") then return false,"Paste a config first" end
		local ok,decoded=pcall(function() return HttpService:JSONDecode(text) end)
		if not ok or type(decoded)~="table" or type(decoded.d)~="table" then return false,"Invalid config" end
		apply(decoded.d) return true,"Config loaded"
	end
	function Config.Save(name) Config.Slots[name]=capture() end
	function Config.Load(name) local data=Config.Slots[name] if not data then return false end apply(data) return true end
	function Config.Delete(name) Config.Slots[name]=nil end
	function Config.Names() local names={} for name in pairs(Config.Slots) do table.insert(names,name) end table.sort(names) return names end
	function Config.ResetAll() apply(Config.Defaults) end
	return Config
end)()
