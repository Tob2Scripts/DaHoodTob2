		local list=Users.List()if #list==0 then return end
		local index=table.find(list,Users.Target)or(step>0 and 0 or 1)
		index=(index-1+step)%#list+1 Users.SetTarget(list[index])
	end
	function Users.Info()
		local obj=Users.Target if not isValid(obj)then return "No target selected"end
		local _,hum,root=targetParts(obj)local mine=myRoot()
		if hum and root and mine then
			return string.format("%s  |  %d HP  |  %d studs",displayName(obj),math.floor(hum.Health+0.5),math.floor((root.Position-mine.Position).Magnitude+0.5))
		end
		return displayName(obj).."  |  no character"
	end
	RunService.Heartbeat:Connect(function()
		local obj=Users.Target
		if Users.Spectating then
			local cam=Workspace.CurrentCamera local _,hum=targetParts(obj)
			if not isValid(obj)or not hum then Users.SetSpectating(false)
			elseif cam and cam.CameraSubject~=hum then cam.CameraSubject=hum end
		end
		if Users.Following then
			if not isValid(obj)then Users.Following=false changedEvent:Fire()
			else local _,_,tr=targetParts(obj)local root=myRoot()if tr and root then root.CFrame=tr.CFrame*CFrame.new(0,0,4)end end
		end
	end)
	return Users
end)()
