	local function displayName(obj)if obj:IsA("Player")then return obj.DisplayName end return obj.Name end
	local function targetParts(obj)
		if not obj then return nil,nil,nil end
		local char=obj:IsA("Player")and obj.Character or obj
		return char,char and char:FindFirstChildOfClass("Humanoid"),char and char:FindFirstChild("HumanoidRootPart")
	end
	local function isValid(obj)return obj~=nil and obj.Parent~=nil end
	local function myRoot()local char=player.Character return char and char:FindFirstChild("HumanoidRootPart")end
	function Users.List()
		local list={}
		for _,plr in ipairs(Players:GetPlayers())do if plr~=player then table.insert(list,plr)end end
		table.sort(list,function(a,b)return a.Name:lower()<b.Name:lower()end)return list
	end
	function Users.Search(query)
		query=string.lower(query) local matches,loose={},{}
		for _,obj in ipairs(Users.List())do
			local name=obj.Name:lower()local disp=displayName(obj):lower()
			if query==""or name:sub(1,#query)==query or disp:sub(1,#query)==query then table.insert(matches,obj)
			elseif name:find(query,1,true)or disp:find(query,1,true)then table.insert(loose,obj)end
		end
		for _,o in ipairs(loose)do table.insert(matches,o)end return matches
	end
