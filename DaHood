-- CONFIG  (depends on all module Settings tables)
-- ══════════════════════════════════════════════════════
local Config=(function()
	local Config={} Config.Slots={}
	Config.Sections={CamLock=Aim.Settings.CamLock,SilentAim=Aim.Settings.SilentAim,ESP=ESP.Settings,Movement=Movement.Settings,RapidFire=RapidFire.Settings,DaHood=DaHood.Settings,Menu=MenuSettings}
	local function encode(v)
		local k=typeof(v)
		if k=="boolean"or k=="string"then return v end
		if k=="number"then if v==v and v~=math.huge and v~=-math.huge then return v end return nil end
		if k=="EnumItem"then return{Enum=tostring(v.EnumType),Name=v.Name}end return nil
	end
	local function decode(saved,current,key)
		if type(saved)=="table"then
			if saved.Enum and saved.Name then
				local ok,et=pcall(function()return Enum[saved.Enum]end)
				if ok and et then local ok2,item=pcall(function()return et[saved.Name]end)if ok2 and item then return item end end
			end return nil
		end
		if key:sub(-4)=="Bind"and saved==false then return false end
		if type(saved)==type(current)then return saved end return nil
	end
	local function capture()
		local data={}
		for sn,section in pairs(Config.Sections)do
			local out={}
			for key,value in pairs(section)do local e=encode(value)if e~=nil then out[key]=e end end
			data[sn]=out
		end
		return data
	end
	local function apply(data)
		for sn,saved in pairs(data)do
			local section=Config.Sections[sn]
			if section and type(saved)=="table"then
				for key,sv in pairs(saved)do
					local current=section[key]
					if current~=nil and type(current)~="function"and type(current)~="table"then
						local v=decode(sv,current,key)
						if section==MenuSettings and(not v or v.EnumType~=Enum.KeyCode)then v=nil end
						if v~=nil then section[key]=v end
					end
				end
			end
		end
	end
	Config.Defaults=capture()
	function Config.Export()local ok,r=pcall(function()return HttpService:JSONEncode({v=1,d=capture()})end)return ok and r or""end
	function Config.Import(text)
		if type(text)~="string"or text:match("^%s*$")then return false,"Paste a config first"end
		local ok,decoded=pcall(function()return HttpService:JSONDecode(text)end)
		if not ok or type(decoded)~="table"or type(decoded.d)~="table"then return false,"Invalid config"end
		apply(decoded.d)return true,"Config loaded"
	end
	function Config.Save(name)Config.Slots[name]=capture()end
	function Config.Load(name)local data=Config.Slots[name]if not data then return false end apply(data)return true end
	function Config.Delete(name)Config.Slots[name]=nil end
	function Config.Names()local names={}for name in pairs(Config.Slots)do table.insert(names,name)end table.sort(names)return names end
	function Config.ResetAll()apply(Config.Defaults)end
	return Config
end)()
_G.Tob2Config=Config
