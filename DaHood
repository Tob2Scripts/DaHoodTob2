		local pg=game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
		local old=pg:FindFirstChild("Tob2Error") if old then old:Destroy() end
		local eg=Instance.new("ScreenGui") eg.Name="Tob2Error" eg.ResetOnSpawn=false eg.DisplayOrder=999 eg.IgnoreGuiInset=true eg.Parent=pg
		local bg=Instance.new("Frame") bg.AnchorPoint=Vector2.new(0.5,0) bg.Position=UDim2.new(0.5,0,0,12) bg.Size=UDim2.new(0.9,0,0,0) bg.AutomaticSize=Enum.AutomaticSize.Y bg.BackgroundColor3=Color3.fromRGB(40,10,10) bg.BorderSizePixel=0 bg.Parent=eg
		local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,8) c.Parent=bg
